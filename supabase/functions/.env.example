# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont injectés automatiquement par Supabase.
# Enregistrer les valeurs réelles avec : supabase secrets set --env-file supabase/functions/.env
APP_URL=https://foottime.example
APP_ENV=development            # 'production' désactive définitivement le sandbox
ALLOWED_ORIGIN=https://foottime.example
PAYMENTS_SANDBOX=true          # false en production
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
